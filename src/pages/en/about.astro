---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import { site } from '../../data/site.js';
---
<Base title="About us | EFD" description="We build development solutions with communities" lang="en">
  <PageHero title="About us" subtitle="We build development solutions with communities" lang="en" />
  <section class="section">
    <div class="container">
      <div class="info-grid">
        <div class="info-card">
          <h3>Our organization</h3>
          <p>Edrak Foundation for Development is a local organization that supports communities and development efforts in Yemen through partnerships and programs focused on empowerment and well-being.</p>
        </div>
        <div class="info-card">
          <h3>Contact</h3>
          <ul class="contact-list compact">
            <li><strong>Phone:</strong> <a href={site.phoneHref}>{site.phone}</a></li>
            <li><strong>Address:</strong> <span>{site.addressEn}</span></li>
            <li><strong>Facebook:</strong> <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
