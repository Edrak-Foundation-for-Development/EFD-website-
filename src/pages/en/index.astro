---
import Base from '../../layouts/Base.astro'; import {programsEn,newsEn} from '../../data/site.js';
---
<Base title="Edrak Foundation for Development | EFD" description="Official website of Edrak Foundation for Development" lang="en">
<section class="hero"><div class="container"><div class="hero-content"><span class="eyebrow">Together for lasting impact</span><h1>Empowering communities to shape their future</h1><p>We partner with communities to build practical development solutions that advance dignity, opportunity and resilience.</p><div class="actions"><a class="btn" href="/en/projects">Explore our projects</a><a class="btn outline" href="/en/about">About us</a></div></div></div></section>
<div class="container stats"><div class="stats-inner"><div class="stat"><strong>+25</strong><small>Projects</small></div><div class="stat"><strong>8</strong><small>Governorates</small></div><div class="stat"><strong>+40K</strong><small>People reached</small></div><div class="stat"><strong>+18</strong><small>Partners</small></div></div></div>
<section class="section"><div class="container split"><div><span class="kicker">Who we are</span><h2>Real development starts with people</h2><p class="lead">EFD is a civil society organization helping communities turn priorities into lasting solutions.</p><div class="quote">Displayed figures are placeholders and must be replaced before launch.</div><a class="btn" href="/en/about">More about EFD</a></div><div class="visual"><img src="/images/cover-3.svg" alt="Development activities"/></div></div></section>
<section class="section alt"><div class="container"><div class="section-head center"><span class="kicker">Our programs</span><h2>Integrated areas of work</h2><p class="lead">Programs designed for immediate needs and long-term development.</p></div><div class="grid g3">{programsEn.map((x,i)=><article class="card"><div class="card-body"><div class="icon">{x.icon}</div><h3>{x.title}</h3><p>{x.desc}</p><a class="link" href={'/en/programs/program-' +(i+1)}>Learn more →</a></div></article>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="kicker">Latest updates</span><h2>News and activities</h2></div><a class="link" href="/en/news">View all news</a></div><div class="grid g3">{newsEn.map(x=><article class="card"><img class="card-img" src={'/images/cover-'+x.img+'.svg'} alt=""/><div class="card-body"><div class="meta">{x.date}</div><h3>{x.title}</h3><p>Sample summary to be replaced with approved content.</p><a class="link" href="/en/news/sample">Details →</a></div></article>)}</div></div></section>
<section class="section alt"><div class="container"><div class="section-head center"><span class="kicker">Impact partners</span><h2>We work in partnership</h2></div><div class="partners">{['PARTNER 01','PARTNER 02','PARTNER 03','PARTNER 04','PARTNER 05','PARTNER 06'].map(x=><div class="partner">{x}</div>)}</div></div></section>
<section class="section"><div class="container"><div class="cta"><div><h2>Let us create lasting impact together</h2><p>Contact us to partner, volunteer or learn more about our work.</p></div><a class="btn light" href="/en/contact">Contact us</a></div></div></section></Base>
