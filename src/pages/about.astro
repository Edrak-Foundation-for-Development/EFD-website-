---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site.js';
---
<Base title="من نحن | EFD" description="نبني حلولًا تنموية بالشراكة مع المجتمعات" lang="ar">
  <PageHero title="من نحن" subtitle="نبني حلولًا تنموية بالشراكة مع المجتمعات" lang="ar" />
  <section class="section">
    <div class="container">
      <div class="info-grid">
        <div class="info-card">
          <h3>معلومات المؤسسة</h3>
          <p>مؤسسة إدراك للتنمية مؤسسة محلية تعمل على دعم المجتمعات والجهود التنموية في اليمن عبر الشراكات والبرامج الموجهة نحو التمكين والرفاه.</p>
        </div>
        <div class="info-card">
          <h3>التواصل</h3>
          <ul class="contact-list compact">
            <li><strong>الهاتف:</strong> <a href={site.phoneHref}>{site.phone}</a></li>
            <li><strong>العنوان:</strong> <span>{site.addressAr}</span></li>
            <li><strong>الفيسبوك:</strong> <a href={site.facebook} target="_blank" rel="noopener noreferrer">Facebook</a></li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
