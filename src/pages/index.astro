---
import Base from '../layouts/Base.astro'; import {programsAr,newsAr} from '../data/site.js';
---
<Base title="مؤسسة إدراك للتنمية | EFD" description="الموقع الرسمي لمؤسسة إدراك للتنمية" lang="ar">
<section class="hero"><div class="container"><div class="hero-content"><span class="eyebrow">معًا نحو أثر مستدام</span><h1>نُمكّن المجتمعات لتصنع مستقبلها</h1><p>نعمل بالشراكة مع المجتمعات لبناء حلول تنموية عملية تعزز الكرامة والفرص والقدرة على الصمود.</p><div class="actions"><a class="btn" href="/projects">استكشف مشاريعنا</a><a class="btn outline" href="/about">تعرف علينا</a></div></div></div></section>
<div class="container stats"><div class="stats-inner"><div class="stat"><strong>+25</strong><small>مشروعًا</small></div><div class="stat"><strong>8</strong><small>محافظات</small></div><div class="stat"><strong>+40K</strong><small>مستفيدًا</small></div><div class="stat"><strong>+18</strong><small>شريكًا</small></div></div></div>
<section class="section"><div class="container split"><div><span class="kicker">من نحن</span><h2>تنمية حقيقية تبدأ من الإنسان</h2><p class="lead">مؤسسة إدراك للتنمية منظمة مجتمع مدني تسعى إلى دعم المجتمعات وتحويل الاحتياجات إلى حلول قابلة للاستمرار.</p><div class="quote">الأرقام المعروضة تجريبية، وتستبدل بالمؤشرات الرسمية قبل الإطلاق النهائي.</div><a class="btn" href="/about">المزيد عن المؤسسة</a></div><div class="visual"><img src="/images/cover-3.svg" alt="أنشطة تنموية"/></div></div></section>
<section class="section alt"><div class="container"><div class="section-head center"><span class="kicker">برامجنا</span><h2>مجالات تدخل مترابطة</h2><p class="lead">برامج مصممة للاستجابة للاحتياجات وتعزيز التنمية طويلة الأمد.</p></div><div class="grid g3">{programsAr.map((x,i)=><article class="card"><div class="card-body"><div class="icon">{x.icon}</div><h3>{x.title}</h3><p>{x.desc}</p><a class="link" href={'/programs/program-'+(i+1)}>اقرأ المزيد ←</a></div></article>)}</div></div></section>
<section class="section"><div class="container"><div class="section-head"><div><span class="kicker">آخر المستجدات</span><h2>الأخبار والأنشطة</h2></div><a class="link" href="/news">عرض جميع الأخبار</a></div><div class="grid g3">{newsAr.map(x=><article class="card"><img class="card-img" src={'/images/cover-'+x.img+'.svg'} alt=""/><div class="card-body"><div class="meta">{x.date}</div><h3>{x.title}</h3><p>ملخص تجريبي للخبر، يستبدل بالمادة الإعلامية المعتمدة.</p><a class="link" href="/news/sample">التفاصيل ←</a></div></article>)}</div></div></section>
<section class="section alt"><div class="container"><div class="section-head center"><span class="kicker">شركاء الأثر</span><h2>نعمل بالشراكة</h2></div><div class="partners">{['PARTNER 01','PARTNER 02','PARTNER 03','PARTNER 04','PARTNER 05','PARTNER 06'].map(x=><div class="partner">{x}</div>)}</div></div></section>
<section class="section"><div class="container"><div class="cta"><div><h2>لنبنِ أثرًا مستدامًا معًا</h2><p>تواصل معنا للشراكة أو التطوع أو معرفة المزيد عن برامج المؤسسة.</p></div><a class="btn light" href="/contact">تواصل معنا</a></div></div></section></Base>
