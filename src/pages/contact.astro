---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { site } from '../data/site.js';
---
<Base title="اتصل بنا | EFD" description="تواصل مع مؤسسة إدراك للتنمية" lang="ar">
  <PageHero title="اتصل بنا" subtitle="نسعد بتواصلكم وشراكتك" lang="ar" />
  <section class="section">
    <div class="container contact-layout">
      <div class="contact-card">
        <h3>معلومات التواصل</h3>
        <ul class="contact-list">
          <li>
            <strong>الهاتف:</strong>
            <a href={site.phoneHref}>{site.phone}</a>
          </li>
          <li>
            <strong>العنوان:</strong>
            <span>{site.addressAr}</span>
          </li>
          <li>
            <strong>البريد الإلكتروني:</strong>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <strong>الفيسبوك:</strong>
            <a href={site.facebook} target="_blank" rel="noopener noreferrer">Edrak Foundation for Development</a>
          </li>
        </ul>
      </div>

      <div class="contact-card">
        <h3>قيم شراكتك</h3>
        <p>نرحب بالاستفسارات، التعاون، المبادرات المجتمعية، والدعم الميداني. تواصل معنا لتبادل المعرفة، دعم المشاريع، أو بناء شراكات تنموية مستدامة.</p>
        <div class="cta-row">
          <a href={`mailto:${site.email}`} class="primary-btn">راسلنا</a>
          <a href={site.facebook} target="_blank" rel="noopener noreferrer" class="secondary-btn">Facebook</a>
        </div>
      </div>
    </div>
  </section>
</Base>
