---
import '../styles/global.css'; import Header from '../components/Header.astro'; import Footer from '../components/Footer.astro';
const {title,description,lang='ar'}=Astro.props; const dir=lang==='ar'?'rtl':'ltr'; const path=Astro.url.pathname;
---
<!doctype html><html lang={lang} dir={dir}><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width"/><meta name="description" content={description}/><meta name="theme-color" content="#0b6b52"/><link rel="icon" href="/favicon.svg"/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><title>{title}</title></head><body><Header lang={lang} path={path}/><main><slot/></main><Footer lang={lang}/></body></html>
