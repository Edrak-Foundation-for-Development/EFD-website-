---
import { site } from '../data/site.js';
const { lang = 'ar' } = Astro.props;
const ar = lang === 'ar';
const p = ar ? '' : '/en';
---
<footer class="footer">
  <div class="container">
    <div class="footer-grid">
      <div>
        <div class="brand footer-brand">
          <img src={site.logo} alt={ar ? site.nameAr : site.nameEn} class="site-logo" />
          <span class="brandtext"><strong style="color:white">{ar ? site.nameAr : site.nameEn}</strong></span>
        </div>
        <p>{ar ? 'نبني شراكات متميزة لدعم المجتمعات وتعزيز التنمية المستدامة.' : 'We build meaningful partnerships to support communities and sustainable development.'}</p>
      </div>

      <div>
        <h4>{ar ? 'معلومات التواصل' : 'Contact information'}</h4>
        <ul class="contact-list">
          <li><a href={site.phoneHref}>{site.phone}</a></li>
          <li><span>{ar ? site.addressAr : site.addressEn}</span></li>
          <li><a href={`mailto:${site.email}`}>{site.email}</a></li>
        </ul>
      </div>

      <div>
        <h4>{ar ? 'تابعنا' : 'Follow us'}</h4>
        <div class="social-links">
          <a href={site.facebook} target="_blank" rel="noopener noreferrer" aria-label={ar ? site.facebookLabelAr : site.facebookLabelEn} class="social-link">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <path d="M13.5 22v-8h2.7l.4-3.1h-3.1V7.2c0-.9.3-1.5 1.7-1.5H17V2.8c-.3 0-1.3-.1-2.6-.1-2.6 0-4.4 1.6-4.4 4.5v2.6H7.5V14h2.5v8h3.5Z" fill="currentColor"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</footer>
